{
  "name": "sprint-report-generator",
  "version": "2.20.0",
  "description": "Sprint Report Generator",
  "main": "src/userscript/index.tsx",
  "scripts": {
    "build": "rm -rf node_modules/.vite && vite build",
    "build:dev": "rm -rf node_modules/.vite && vite build --mode development",
    "build:watch": "vite build --watch --mode development",
    "build:extension": "vite build --config vite.extension.config.mts",
    "dev:extension": "vite --config vite.extension.config.mts",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "dev": "vite",
    "lint": "prettier --check \"**/*.{md,yml}\" && biome check && knip",
    "lint:fix": "prettier --write \"**/*.{md,yml}\" && biome check --write && knip --fix",
    "tcm": "tcm src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "version": "node scripts/update-versions.js",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agile-casino/ados-helper.git"
  },
  "author": "archerax",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/agile-casino/ados-helper/issues"
  },
  "homepage": "https://github.com/agile-casino/ados-helper#readme",
  "packageManager": "pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664",
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.3",
    "@tsconfig/strictest": "^2.0.8",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "lint-staged": "^17.5.0",
    "postcss-preset-mantine": "^1.18.0",
    "prettier": "^3.9.6",
    "tfx-cli": "^0.24.0",
    "typed-css-modules": "^0.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-banner": "^0.8.1",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@mantine/core": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "azure-devops-extension-sdk": "^5.0.0",
    "happy-dom": "^20.14.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lodash": "^4.18.1",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript-plugin-css-modules": "^5.2.0",
    "xlsx-js-style": "^1.2.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json}": "biome check --write",
    "*.{md,yml}": "prettier --write"
  }
}
